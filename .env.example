# ── Database ──────────────────────────────────────────────────────────────────
# Supabase → Settings → Database → Connection string (URI mode)
# Replace [YOUR-PASSWORD] with your actual DB password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── AWS S3 (Profile Image & Asset Uploads) ──────────────────────────────────
# Required for live AWS S3 profile picture uploads (Optional for local dev)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=fundsroom-user-avatars

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# These go in frontend/.env (prefix VITE_)
VITE_API_URL=http://localhost:5000

